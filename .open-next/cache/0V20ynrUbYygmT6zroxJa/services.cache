{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/services/layout,_N_T_/services/page,_N_T_/services"},"segmentPaths":["/_tree","/_full","/services/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"h-full antialiased\" style=\"--font-manrope:&#x27;Manrope Variable&#x27;, sans-serif;--font-karla:&#x27;Karla&#x27;, sans-serif\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/280b6p5tv856z.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2mmpezlrfmbu5.js\" async=\"\"></script><script src=\"/_next/static/chunks/08ttfj81-47mu.js\" async=\"\"></script><script src=\"/_next/static/chunks/27rnsu2jhy6z2.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-40xjmwjowkqn7.js\" async=\"\"></script><script src=\"/_next/static/chunks/3fntmmi971322.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/0ho69r9xg1nxv.js\" async=\"\" crossorigin=\"\"></script><title>Mehran Dental Care — Hyderabad</title><meta name=\"description\" content=\"Neighborhood dental clinic in Latifabad, Hyderabad. Scaling, whitening, root treatment, dentures, orthodontics, and more.\"/><link rel=\"manifest\" href=\"/manifest.json\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-line\"><div class=\"mx-auto max-w-6xl px-5 md:px-8 h-16 flex items-center justify-between\"><a class=\"font-display font-extrabold text-lg text-ink tracking-tight\" href=\"/\">Mehran Dental<span class=\"text-teal\">.</span></a><nav class=\"hidden md:flex items-center gap-8 text-sm font-medium text-ink/70\"><a class=\"hover:text-ink transition-colors\" href=\"/services\">Services</a><a class=\"hover:text-ink transition-colors\" href=\"/about\">About</a><a class=\"hover:text-ink transition-colors\" href=\"/contact\">Contact</a></nav><div class=\"flex items-center gap-3\"><a href=\"tel:03352411106\" class=\"hidden sm:inline text-sm font-semibold text-ink/70 hover:text-ink\">0335 2411106</a><a class=\"hidden sm:inline-block rounded-full bg-teal text-white text-sm font-semibold px-4 py-2 hover:bg-teal-dark transition-colors\" href=\"/contact\">Book a visit</a><button type=\"button\" aria-label=\"Open menu\" aria-expanded=\"false\" class=\"md:hidden p-2 -mr-2 rounded-md text-ink/80 hover:bg-ink/5 active:bg-ink/10 transition\"><svg viewBox=\"0 0 24 24\" class=\"h-6 w-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 7h16M4 12h16M4 17h16\" stroke-linecap=\"round\"></path></svg></button></div></div><div class=\"md:hidden overflow-hidden transition-[max-height] duration-200 ease-in-out bg-white border-b border-line max-h-0\"><nav class=\"flex flex-col px-5 py-2\"><a class=\"py-3 text-base font-medium text-ink/80 border-b border-line last:border-b-0\" href=\"/services\">Services</a><a class=\"py-3 text-base font-medium text-ink/80 border-b border-line last:border-b-0\" href=\"/about\">About</a><a class=\"py-3 text-base font-medium text-ink/80 border-b border-line last:border-b-0\" href=\"/contact\">Contact</a><a href=\"tel:03352411106\" class=\"py-3 text-base font-medium text-ink/80 border-b border-line\">Call: 0335 2411106</a><a class=\"my-3 text-center rounded-full bg-teal text-white text-sm font-semibold px-4 py-2.5 hover:bg-teal-dark transition-colors\" href=\"/contact\">Book a visit</a></nav></div></header><section class=\"bg-mint py-16 md:py-20\"><div class=\"mx-auto max-w-6xl px-5 md:px-8\"><p class=\"text-xs font-semibold tracking-wide uppercase text-teal-dark\">What we treat</p><h1 class=\"font-display font-extrabold text-4xl text-ink mt-2\">Services</h1><p class=\"text-ink/70 mt-3 max-w-lg\">General and cosmetic dentistry for every stage of life. Not sure what you need? Message us and we&#x27;ll point you in the right direction.</p></div></section><section class=\"mx-auto max-w-6xl px-5 md:px-8 py-16 md:py-20\"><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-5\"><div class=\"rounded-2xl border border-line p-7 hover:border-teal/40 transition-colors\"><p class=\"font-display font-bold text-lg text-ink\">Scaling &amp; Cleaning</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Routine polish and plaque removal to keep gums healthy between checkups.</p><a href=\"https://wa.me/923352411106?text=Hi%20Mehran%20Dental%20Care%2C%20I&#x27;d%20like%20to%20book%20an%20appointment.%20My%20name%20is%3A%20___.%20Preferred%20day%2Ftime%3A%20___.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block mt-4 text-sm font-semibold text-teal hover:text-teal-dark\">Ask about this on WhatsApp →</a></div><div class=\"rounded-2xl border border-line p-7 hover:border-teal/40 transition-colors\"><p class=\"font-display font-bold text-lg text-ink\">Teeth Whitening</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Brighten your smile with an in-clinic whitening treatment.</p><a href=\"https://wa.me/923352411106?text=Hi%20Mehran%20Dental%20Care%2C%20I&#x27;d%20like%20to%20book%20an%20appointment.%20My%20name%20is%3A%20___.%20Preferred%20day%2Ftime%3A%20___.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block mt-4 text-sm font-semibold text-teal hover:text-teal-dark\">Ask about this on WhatsApp →</a></div><div class=\"rounded-2xl border border-line p-7 hover:border-teal/40 transition-colors\"><p class=\"font-display font-bold text-lg text-ink\">Root Canal Treatment</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Save a damaged or infected tooth and relieve pain at the source.</p><a href=\"https://wa.me/923352411106?text=Hi%20Mehran%20Dental%20Care%2C%20I&#x27;d%20like%20to%20book%20an%20appointment.%20My%20name%20is%3A%20___.%20Preferred%20day%2Ftime%3A%20___.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block mt-4 text-sm font-semibold text-teal hover:text-teal-dark\">Ask about this on WhatsApp →</a></div><div class=\"rounded-2xl border border-line p-7 hover:border-teal/40 transition-colors\"><p class=\"font-display font-bold text-lg text-ink\">Crowning &amp; Capping</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Restore a weakened tooth&#x27;s strength, shape, and appearance.</p><a href=\"https://wa.me/923352411106?text=Hi%20Mehran%20Dental%20Care%2C%20I&#x27;d%20like%20to%20book%20an%20appointment.%20My%20name%20is%3A%20___.%20Preferred%20day%2Ftime%3A%20___.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block mt-4 text-sm font-semibold text-teal hover:text-teal-dark\">Ask about this on WhatsApp →</a></div><div class=\"rounded-2xl border border-line p-7 hover:border-teal/40 transition-colors\"><p class=\"font-display font-bold text-lg text-ink\">Dentures (Fixed &amp; Removable)</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Comfortable replacements for missing teeth, custom-fitted.</p><a href=\"https://wa.me/923352411106?text=Hi%20Mehran%20Dental%20Care%2C%20I&#x27;d%20like%20to%20book%20an%20appointment.%20My%20name%20is%3A%20___.%20Preferred%20day%2Ftime%3A%20___.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block mt-4 text-sm font-semibold text-teal hover:text-teal-dark\">Ask about this on WhatsApp →</a></div><div class=\"rounded-2xl border border-line p-7 hover:border-teal/40 transition-colors\"><p class=\"font-display font-bold text-lg text-ink\">Orthodontic Treatment</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Straighten teeth and correct bite alignment over time.</p><a href=\"https://wa.me/923352411106?text=Hi%20Mehran%20Dental%20Care%2C%20I&#x27;d%20like%20to%20book%20an%20appointment.%20My%20name%20is%3A%20___.%20Preferred%20day%2Ftime%3A%20___.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block mt-4 text-sm font-semibold text-teal hover:text-teal-dark\">Ask about this on WhatsApp →</a></div><div class=\"rounded-2xl border border-line p-7 hover:border-teal/40 transition-colors\"><p class=\"font-display font-bold text-lg text-ink\">Tooth Replacement</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Options to replace missing teeth and restore full function.</p><a href=\"https://wa.me/923352411106?text=Hi%20Mehran%20Dental%20Care%2C%20I&#x27;d%20like%20to%20book%20an%20appointment.%20My%20name%20is%3A%20___.%20Preferred%20day%2Ftime%3A%20___.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block mt-4 text-sm font-semibold text-teal hover:text-teal-dark\">Ask about this on WhatsApp →</a></div><div class=\"rounded-2xl border border-line p-7 hover:border-teal/40 transition-colors\"><p class=\"font-display font-bold text-lg text-ink\">Surgical Treatment</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Extractions and minor oral surgery performed with care.</p><a href=\"https://wa.me/923352411106?text=Hi%20Mehran%20Dental%20Care%2C%20I&#x27;d%20like%20to%20book%20an%20appointment.%20My%20name%20is%3A%20___.%20Preferred%20day%2Ftime%3A%20___.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block mt-4 text-sm font-semibold text-teal hover:text-teal-dark\">Ask about this on WhatsApp →</a></div></div></section><footer class=\"bg-ink text-white mt-24\"><div class=\"mx-auto max-w-6xl px-5 md:px-8 py-14 grid grid-cols-1 md:grid-cols-3 gap-10\"><div><p class=\"font-display font-extrabold text-lg\">Mehran Dental<span class=\"text-teal\">.</span></p><p class=\"mt-3 text-sm text-white/60 leading-relaxed max-w-xs\">A neighborhood dental clinic in Latifabad, Hyderabad — general and cosmetic dentistry for the whole family.</p></div><div class=\"text-sm\"><p class=\"font-semibold text-white/90 mb-3\">Visit us</p><p class=\"text-white/60 leading-relaxed\">Unit No. 10, Market Road, near Afzal Ground, Latifabad Unit 10, Hyderabad, 71000</p><p class=\"text-white/60 mt-2\">0335 2411106</p></div><div class=\"text-sm\"><p class=\"font-semibold text-white/90 mb-3\">Explore</p><ul class=\"space-y-2 text-white/60\"><li><a class=\"hover:text-white\" href=\"/services\">Services</a></li><li><a class=\"hover:text-white\" href=\"/about\">About</a></li><li><a class=\"hover:text-white\" href=\"/contact\">Contact</a></li><li><a class=\"hover:text-white\" href=\"/portal/login\">Staff login</a></li></ul></div></div><div class=\"border-t border-white/10 py-5\"><p class=\"text-center text-xs text-white/40\">© <!-- -->2026<!-- --> Mehran Dental Care, Hyderabad.</p></div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[39756,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"default\\\"]\\n3:I[37457,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"default\\\"]\\n4:I[93092,[\\\"/_next/static/chunks/3fntmmi971322.js\\\",\\\"/_next/static/chunks/0ho69r9xg1nxv.js\\\"],\\\"PublicNav\\\"]\\n10:I[68027,[\\\"/_next/static/chunks/3fntmmi971322.js\\\"],\\\"default\\\",1]\\n:HL[\\\"/_next/static/chunks/280b6p5tv856z.css\\\",\\\"style\\\"]\\n:HC[\\\"/\\\",\\\"\\\"]\\ne:X\\n0:{\\\"P\\\":null,\\\"c\\\":[\\\"\\\",\\\"services\\\"],\\\"q\\\":\\\"\\\",\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"services\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{},\\\"$undefined\\\",\\\"$undefined\\\",4608]},\\\"$undefined\\\",\\\"$undefined\\\",4608]},\\\"$undefined\\\",\\\"$undefined\\\",4624],[[\\\"$