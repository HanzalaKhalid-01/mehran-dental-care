{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/,_N_T_/index"},"segmentPaths":["/_tree","/_full","/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":160,"slots":null}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"h-full antialiased\" style=\"--font-manrope:&#x27;Manrope Variable&#x27;, sans-serif;--font-karla:&#x27;Karla&#x27;, sans-serif\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2vk6w0uvu23be.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2mmpezlrfmbu5.js\" async=\"\"></script><script src=\"/_next/static/chunks/08ttfj81-47mu.js\" async=\"\"></script><script src=\"/_next/static/chunks/27rnsu2jhy6z2.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-40xjmwjowkqn7.js\" async=\"\"></script><script src=\"/_next/static/chunks/3fntmmi971322.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/22i43cg4l4-dq.js\" async=\"\" crossorigin=\"\"></script><title>Mehran Dental Care — Hyderabad</title><meta name=\"description\" content=\"Neighborhood dental clinic in Latifabad, Hyderabad. Scaling, whitening, root treatment, dentures, orthodontics, and more.\"/><link rel=\"manifest\" href=\"/manifest.json\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-line\"><div class=\"mx-auto max-w-6xl px-5 md:px-8 h-16 flex items-center justify-between\"><a class=\"font-display font-extrabold text-lg text-ink tracking-tight\" href=\"/\">Mehran Dental<span class=\"text-teal\">.</span></a><nav class=\"hidden md:flex items-center gap-8 text-sm font-medium text-ink/70\"><a class=\"hover:text-ink transition-colors\" href=\"/services\">Services</a><a class=\"hover:text-ink transition-colors\" href=\"/about\">About</a><a class=\"hover:text-ink transition-colors\" href=\"/contact\">Contact</a></nav><div class=\"flex items-center gap-3\"><a href=\"tel:03352411106\" class=\"hidden sm:inline text-sm font-semibold text-ink/70 hover:text-ink\">0335 2411106</a><a class=\"rounded-full bg-teal text-white text-sm font-semibold px-4 py-2 hover:bg-teal-dark transition-colors\" href=\"/contact\">Book a visit</a></div></div></header><section class=\"relative overflow-hidden bg-mint\"><div class=\"mx-auto max-w-6xl px-5 md:px-8 pt-16 pb-24 md:pt-24 md:pb-32 grid grid-cols-1 md:grid-cols-2 gap-14 items-center\"><div><p class=\"inline-block text-xs font-semibold tracking-wide uppercase text-teal-dark bg-white/70 rounded-full px-3 py-1\">Latifabad, Hyderabad</p><h1 class=\"font-display font-extrabold text-4xl md:text-5xl leading-[1.08] tracking-tight text-ink mt-5\">Dental care that feels<br/>like it&#x27;s next door.</h1><p class=\"text-ink/70 text-base md:text-lg mt-5 max-w-md leading-relaxed\">General and cosmetic dentistry for the whole family — scaling, whitening, root treatment, dentures, and more, from a clinic that knows the neighborhood.</p><div class=\"flex flex-wrap items-center gap-3 mt-8\"><a href=\"https://wa.me/923352411106?text=Hi%20Mehran%20Dental%20Care%2C%20I&#x27;d%20like%20to%20book%20an%20appointment.%20My%20name%20is%3A%20___.%20Preferred%20day%2Ftime%3A%20___.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"rounded-full bg-teal text-white font-semibold px-6 py-3 text-sm hover:bg-teal-dark transition-colors\">Book on WhatsApp</a><a href=\"tel:03352411106\" class=\"rounded-full border border-ink/15 text-ink font-semibold px-6 py-3 text-sm hover:bg-white transition-colors\">Call <!-- -->0335 2411106</a></div><div class=\"flex items-center gap-2 mt-8 text-sm text-ink/60\"><span class=\"text-marigold font-semibold\">★ 4.0</span><span>· based on patient reviews on Google</span></div></div><div class=\"relative\"><div class=\"relative rounded-tl-[3rem] rounded-br-[3rem] rounded-tr-2xl rounded-bl-2xl bg-white shadow-xl shadow-ink/5 p-8 md:p-10\"><svg viewBox=\"0 0 600 200\" fill=\"none\" class=\"absolute -top-10 left-1/2 -translate-x-1/2 w-56 h-20 text-teal/30\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><path d=\"M0 20 C 150 180, 450 180, 600 20\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"></path></svg><p class=\"font-display font-bold text-ink text-lg\">Today&#x27;s hours</p><p class=\"text-ink/60 text-sm mt-1\">Open in two shifts — message us to confirm timing</p><div class=\"mt-5 space-y-3 text-sm\"><div class=\"flex items-center justify-between border-b border-line pb-3\"><span class=\"text-ink/60\">Morning shift</span><span class=\"font-semibold text-ink\">— 4:00 PM</span></div><div class=\"flex items-center justify-between\"><span class=\"text-ink/60\">Evening shift</span><span class=\"font-semibold text-ink\">7:15 PM —</span></div></div><a class=\"mt-6 inline-block text-sm font-semibold text-teal hover:text-teal-dark\" href=\"/contact\">Full hours &amp; directions →</a></div></div></div></section><section class=\"mx-auto max-w-6xl px-5 md:px-8 py-20 md:py-28\"><div class=\"flex items-end justify-between flex-wrap gap-4 mb-10\"><div><p class=\"text-xs font-semibold tracking-wide uppercase text-teal-dark\">What we treat</p><h2 class=\"font-display font-extrabold text-3xl text-ink mt-2\">Services</h2></div><a class=\"text-sm font-semibold text-teal hover:text-teal-dark\" href=\"/services\">View all services →</a></div><div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\"><div class=\"rounded-2xl border border-line p-6 hover:border-teal/40 hover:shadow-md hover:shadow-ink/5 transition-all\"><p class=\"font-display font-bold text-ink\">Scaling &amp; Cleaning</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Routine polish and plaque removal to keep gums healthy between checkups.</p></div><div class=\"rounded-2xl border border-line p-6 hover:border-teal/40 hover:shadow-md hover:shadow-ink/5 transition-all\"><p class=\"font-display font-bold text-ink\">Teeth Whitening</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Brighten your smile with an in-clinic whitening treatment.</p></div><div class=\"rounded-2xl border border-line p-6 hover:border-teal/40 hover:shadow-md hover:shadow-ink/5 transition-all\"><p class=\"font-display font-bold text-ink\">Root Canal Treatment</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Save a damaged or infected tooth and relieve pain at the source.</p></div><div class=\"rounded-2xl border border-line p-6 hover:border-teal/40 hover:shadow-md hover:shadow-ink/5 transition-all\"><p class=\"font-display font-bold text-ink\">Crowning &amp; Capping</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Restore a weakened tooth&#x27;s strength, shape, and appearance.</p></div><div class=\"rounded-2xl border border-line p-6 hover:border-teal/40 hover:shadow-md hover:shadow-ink/5 transition-all\"><p class=\"font-display font-bold text-ink\">Dentures (Fixed &amp; Removable)</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Comfortable replacements for missing teeth, custom-fitted.</p></div><div class=\"rounded-2xl border border-line p-6 hover:border-teal/40 hover:shadow-md hover:shadow-ink/5 transition-all\"><p class=\"font-display font-bold text-ink\">Orthodontic Treatment</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Straighten teeth and correct bite alignment over time.</p></div><div class=\"rounded-2xl border border-line p-6 hover:border-teal/40 hover:shadow-md hover:shadow-ink/5 transition-all\"><p class=\"font-display font-bold text-ink\">Tooth Replacement</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Options to replace missing teeth and restore full function.</p></div><div class=\"rounded-2xl border border-line p-6 hover:border-teal/40 hover:shadow-md hover:shadow-ink/5 transition-all\"><p class=\"font-display font-bold text-ink\">Surgical Treatment</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Extractions and minor oral surgery performed with care.</p></div></div></section><section class=\"bg-sand py-20 md:py-28\"><div class=\"mx-auto max-w-6xl px-5 md:px-8 grid grid-cols-1 md:grid-cols-3 gap-10\"><div><p class=\"text-xs font-semibold tracking-wide uppercase text-teal-dark\">Why patients choose us</p><h2 class=\"font-display font-extrabold text-3xl text-ink mt-2 leading-tight\">A clinic built around your neighborhood, not a waiting room.</h2></div><div class=\"rounded-2xl bg-white p-6 border border-line\"><p class=\"font-display font-bold text-ink\">Two shifts, daily</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Morning and evening hours mean you can find a time that fits your day.</p></div><div class=\"rounded-2xl bg-white p-6 border border-line\"><p class=\"font-display font-bold text-ink\">Message before you visit</p><p class=\"text-sm text-ink/60 mt-2 leading-relaxed\">Reach us on WhatsApp for questions, appointment requests, or directions.</p></div></div></section><section class=\"mx-auto max-w-6xl px-5 md:px-8 py-20 md:py-28\"><div class=\"relative overflow-hidden rounded-tl-[3rem] rounded-br-[3rem] rounded-tr-2xl rounded-bl-2xl bg-ink text-white px-8 py-14 md:px-16 md:py-20 text-center\"><svg viewBox=\"0 0 600 200\" fill=\"none\" class=\"absolute -bottom-10 left-1/2 -translate-x-1/2 w-72 h-24 text-teal/30\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><path d=\"M0 20 C 150 180, 450 180, 600 20\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"></path></svg><h2 class=\"font-display font-extrabold text-3xl md:text-4xl\">Ready for your next visit?</h2><p class=\"text-white/60 mt-3 max-w-md mx-auto\">Send us a message on WhatsApp and we&#x27;ll get you booked in.</p><a href=\"https://wa.me/923352411106?text=Hi%20Mehran%20Dental%20Care%2C%20I&#x27;d%20like%20to%20book%20an%20appointment.%20My%20name%20is%3A%20___.%20Preferred%20day%2Ftime%3A%20___.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block mt-7 rounded-full bg-teal text-white font-semibold px-7 py-3 text-sm hover:bg-teal-dark transition-colors\">Book on WhatsApp</a></div></section><footer class=\"bg-ink text-white mt-24\"><div class=\"mx-auto max-w-6xl px-5 md:px-8 py-14 grid grid-cols-1 md:grid-cols-3 gap-10\"><div><p class=\"font-display font-extrabold text-lg\">Mehran Dental<span class=\"text-teal\">.</span></p><p class=\"mt-3 text-sm text-white/60 leading-relaxed max-w-xs\">A neighborhood dental clinic in Latifabad, Hyderabad — general and cosmetic dentistry for the whole family.</p></div><div class=\"text-sm\"><p class=\"font-semibold text-white/90 mb-3\">Visit us</p><p class=\"text-white/60 leading-relaxed\">Unit No. 10, Market Road, near Afzal Ground, Latifabad Unit 10, Hyderabad, 71000</p><p class=\"text-white/60 mt-2\">0335 2411106</p></div><div class=\"text-sm\"><p class=\"font-semibold text-white/90 mb-3\">Explore</p><ul class=\"space-y-2 text-white/60\"><li><a class=\"hover:text-white\" href=\"/services\">Services</a></li><li><a class=\"hover:text-white\" href=\"/about\">About</a></li><li><a class=\"hover:text-white\" href=\"/contact\">Contact</a></li><li><a class=\"hover:text-white\" href=\"/portal/login\">Staff login</a></li></ul></div></div><div class=\"border-t border-white/10 py-5\"><p class=\"text-center text-xs text-white/40\">© <!-- -->2026<!-- --> Mehran Dental Care, Hyderabad.</p></div></footer><!--$--><!--/$--><script src=\"/_next/static/chunks/310vm2bl3xxpt.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"