{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/about/layout,_N_T_/about/page,_N_T_/about"},"segmentPaths":["/_tree","/_full","/about/__PAGE__"],"prefetchHints":{"hints":64,"slots":{"children":{"hints":96,"slots":{"children":{"hints":160,"slots":null}}}}}},"html":"<!DOCTYPE html><html lang=\"en\" class=\"h-full antialiased\" style=\"--font-manrope:&#x27;Manrope Variable&#x27;, sans-serif;--font-karla:&#x27;Karla&#x27;, sans-serif\"><head><meta charSet=\"utf-8\"/><link rel=\"preconnect\" href=\"/\" crossorigin=\"\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/2vk6w0uvu23be.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/310vm2bl3xxpt.js\"/><script src=\"/_next/static/chunks/2mmpezlrfmbu5.js\" async=\"\"></script><script src=\"/_next/static/chunks/08ttfj81-47mu.js\" async=\"\"></script><script src=\"/_next/static/chunks/27rnsu2jhy6z2.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-40xjmwjowkqn7.js\" async=\"\"></script><script src=\"/_next/static/chunks/3fntmmi971322.js\" async=\"\" crossorigin=\"\"></script><script src=\"/_next/static/chunks/22i43cg4l4-dq.js\" async=\"\" crossorigin=\"\"></script><title>Mehran Dental Care — Hyderabad</title><meta name=\"description\" content=\"Neighborhood dental clinic in Latifabad, Hyderabad. Scaling, whitening, root treatment, dentures, orthodontics, and more.\"/><link rel=\"manifest\" href=\"/manifest.json\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.2vob68tjqpejf.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-full flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"sticky top-0 z-40 bg-white/90 backdrop-blur border-b border-line\"><div class=\"mx-auto max-w-6xl px-5 md:px-8 h-16 flex items-center justify-between\"><a class=\"font-display font-extrabold text-lg text-ink tracking-tight\" href=\"/\">Mehran Dental<span class=\"text-teal\">.</span></a><nav class=\"hidden md:flex items-center gap-8 text-sm font-medium text-ink/70\"><a class=\"hover:text-ink transition-colors\" href=\"/services\">Services</a><a class=\"hover:text-ink transition-colors\" href=\"/about\">About</a><a class=\"hover:text-ink transition-colors\" href=\"/contact\">Contact</a></nav><div class=\"flex items-center gap-3\"><a href=\"tel:03352411106\" class=\"hidden sm:inline text-sm font-semibold text-ink/70 hover:text-ink\">0335 2411106</a><a class=\"rounded-full bg-teal text-white text-sm font-semibold px-4 py-2 hover:bg-teal-dark transition-colors\" href=\"/contact\">Book a visit</a></div></div></header><section class=\"bg-mint py-16 md:py-20\"><div class=\"mx-auto max-w-3xl px-5 md:px-8 text-center\"><p class=\"text-xs font-semibold tracking-wide uppercase text-teal-dark\">About us</p><h1 class=\"font-display font-extrabold text-4xl text-ink mt-2\">Neighborhood dentistry, done properly.</h1></div></section><section class=\"mx-auto max-w-3xl px-5 md:px-8 py-16 md:py-20\"><div class=\"relative rounded-tl-[3rem] rounded-br-[3rem] rounded-tr-2xl rounded-bl-2xl bg-sand p-8 md:p-12\"><svg viewBox=\"0 0 600 200\" fill=\"none\" class=\"absolute -top-8 left-10 w-40 h-14 text-teal/30\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><path d=\"M0 20 C 150 180, 450 180, 600 20\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"></path></svg><p class=\"text-ink/80 leading-relaxed\">Mehran Dental Care is a local clinic in Latifabad, Hyderabad, offering general and cosmetic dental treatment — from routine cleanings and fillings to root canal treatment, dentures, and orthodontics — for patients of all ages.</p><p class=\"text-ink/80 leading-relaxed mt-4\">We keep two daily shifts so that patients with work or school schedules can still find a convenient time, and we handle appointment requests and questions directly over WhatsApp so getting in touch is simple.</p></div><div class=\"grid grid-cols-1 sm:grid-cols-3 gap-5 mt-10\"><div class=\"rounded-2xl border border-line p-6\"><p class=\"font-display font-bold text-ink\">General dentistry</p><p class=\"text-sm text-ink/60 mt-2\">Checkups, cleanings, fillings, and everyday care.</p></div><div class=\"rounded-2xl border border-line p-6\"><p class=\"font-display font-bold text-ink\">Restorative care</p><p class=\"text-sm text-ink/60 mt-2\">Crowns, dentures, root canal, and tooth replacement.</p></div><div class=\"rounded-2xl border border-line p-6\"><p class=\"font-display font-bold text-ink\">Cosmetic treatment</p><p class=\"text-sm text-ink/60 mt-2\">Whitening and orthodontic treatment for your smile.</p></div></div></section><footer class=\"bg-ink text-white mt-24\"><div class=\"mx-auto max-w-6xl px-5 md:px-8 py-14 grid grid-cols-1 md:grid-cols-3 gap-10\"><div><p class=\"font-display font-extrabold text-lg\">Mehran Dental<span class=\"text-teal\">.</span></p><p class=\"mt-3 text-sm text-white/60 leading-relaxed max-w-xs\">A neighborhood dental clinic in Latifabad, Hyderabad — general and cosmetic dentistry for the whole family.</p></div><div class=\"text-sm\"><p class=\"font-semibold text-white/90 mb-3\">Visit us</p><p class=\"text-white/60 leading-relaxed\">Unit No. 10, Market Road, near Afzal Ground, Latifabad Unit 10, Hyderabad, 71000</p><p class=\"text-white/60 mt-2\">0335 2411106</p></div><div class=\"text-sm\"><p class=\"font-semibold text-white/90 mb-3\">Explore</p><ul class=\"space-y-2 text-white/60\"><li><a class=\"hover:text-white\" href=\"/services\">Services</a></li><li><a class=\"hover:text-white\" href=\"/about\">About</a></li><li><a class=\"hover:text-white\" href=\"/contact\">Contact</a></li><li><a class=\"hover:text-white\" href=\"/portal/login\">Staff login</a></li></ul></div></div><div class=\"border-t border-white/10 py-5\"><p class=\